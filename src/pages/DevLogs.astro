---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import posts from "../data/posts.json";

const devlogs = posts.filter((p) => p.page === "Devlogs");
---

<Layout>
  <div class="content rainbow-border">
    {devlogs.length === 0 && <p>No Posts Yet!</p>}
    {devlogs.map((post) => <PostCard post={post} />)}
  </div>
</Layout>
