---
import "../styles/styles.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Potat's Place</title>
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="assets/images/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="assets/images/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="assets/images/favicon/favicon-16x16.png"
    />
  </head>
  <body>
    <header class="rainbow-border">
      <h1 class="sparkles-wrapper"><a href="/">Potat's Place</a></h1>
    </header>
    <div class="wrapper">
      <aside class="sidebar rainbow-border">
        <h1 class="card">NAVIGATE YOURSELF</h1>
        <ul class="nav-items-container card">
          <li class="nav-item"><a href="/TheTrio">The Trio</a></li>
          <li class="nav-item"><a href="/DevLogs">Dev Logs</a></li>
          <li class="nav-item"><a href="/Ballroom">Ballroom Dance</a></li>
        </ul>
        <div class="music-container card">Music Player Coming Soon ~</div>
        <div class="inspo-container card">
          <h2>~ Site Inspo ~</h2>
          <div>
            <a class="site-badge" href="https://nomnomnami.com/">
              <img src="assets/images/nomnomnami_badge.gif" alt="nomnomnami" />
            </a>
            <a class="site-badge" href="https://reigen.moe/home">
              <img src="assets/images/reigenmoe-badge.gif" />
            </a>
            <a class="site-badge" href="https://blamensir.neocities.org/">
              <img src="assets/images/blamensir-badge.png" />
            </a>
          </div>
        </div>
      </aside>
      <slot />
    </div>
  </body>
</html>
